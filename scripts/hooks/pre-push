#!/usr/bin/env bash
# Не выпускает красное из машины.
#
# CI ловит красное после пуша — это лучше, чем ничего, но чинить приходится
# вдогонку, а история уже содержит сломанный коммит. Хук проверяет то же
# самое до отправки.
#
# Аварийный обход: git push --no-verify. Он виден в том смысле, что человек
# набрал его руками; в CI обхода нет.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# Всё, что запущено ниже, работает во временных папках и в своих подпроцессах,
# а не в нашем репозитории. Из связанного дерева (`git worktree`) git передаёт
# хуку абсолютный GIT_DIR, и тест, делающий `git init` во временной папке,
# переинициализировал настоящий репозиторий: 24.09.2026 основная копия стала
# `core.bare = true`, а индекс дерева — одним файлом из теста.
unset $(git rev-parse --local-env-vars)

# Lock-файл против pyproject.toml — тот же шаг, что в CI. Стоит раньше
# проверки `.venv`: ему нужен только uv, и из рабочего дерева без своего
# окружения он тоже идёт. Без `--quiet`: в тихом режиме uv отказывает
# кодом возврата и ни словом не говорит, в чём дело. Ветка, начатая
# раньше, чем появился uv.lock, не останавливается: CI сверит результат
# её слияния с main, где lock-файл уже есть.
if [ ! -f uv.lock ]; then
  echo "── Lock-файл ── в ветке его ещё нет, сверит CI после слияния с main"
elif command -v uv >/dev/null; then
  echo "── Lock-файл ──"; uv lock --check
else
  echo "── Lock-файл ── нет uv, проверит CI (поставить: brew install uv)"
fi

# Волны контура модуля «Продажи»: здесь только предупреждение, пуш проходит;
# красной та же проверка бывает в CI (quality.yml, джоба delivery). Ей хватает
# python3 без .venv, поэтому она стоит до проверки окружения.
echo "── Волны контура ──"
python3 scripts/contour_waves.py --warn --base origin/main \
  || echo "⚠ проверка волн не отработала — её повторит CI"

PY=".venv/bin"
[ -x "$PY/ruff" ] || { echo "Нет .venv — проверки пропущены, CI их сделает."; exit 0; }

echo "── Линтер ──";              "$PY/ruff" check backend/ tests/ scripts/
echo "── Форматирование ──";      "$PY/ruff" format --check backend/ tests/ scripts/
echo "── Типы ──";                "$PY/mypy" backend/ | tail -1
echo "── Архитектурные гейты ──"; "$PY/python" scripts/gates.py
echo "── Ратчет сложности ──";   "$PY/python" scripts/complexity.py
echo "── Тесты ──";               "$PY/pytest" -q | tail -1

# Фронт проверяется тем же набором, что и в CI. Зависимостей нет —
# пропускаем с явным сообщением: тихий пропуск однажды превратится
# в красный CI, который «на машине был зелёный».
if [ -d frontend/node_modules ]; then
  echo "── Фронт ──"
  (cd frontend && npm run lint --silent && npm run format:check --silent >/dev/null \
    && npm run typecheck --silent && npm test --silent -- --reporter=dot | tail -3)
else
  echo "── Фронт ── нет frontend/node_modules, проверит CI (поставить: cd frontend && npm ci)"
fi

echo "Всё зелёное, отправляю."
