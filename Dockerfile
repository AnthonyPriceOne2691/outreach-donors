# Три образа из одного файла: сервер, воркер и фронт.
#
# Сервер и воркер — один и тот же образ с разной командой: у них общий
# код и общие зависимости, а два файла разъехались бы при первой правке
# (воркер получил бы библиотеку, которой нет у сервера, и падал бы
# только в проде).
#
# Фронт — собранные файлы под nginx, а не dev-сервер: dev-сервер отдаёт
# исходники и пересобирает на лету, ему нужны node_modules и он не умеет
# в кэш-заголовки.
#
# Внешние образы — тегом и точным дайджестом индекса (аудит 20.11.2026): тег для человека,
# дайджест для докера. Тег издатель передвигает, и образ, собранный завтра, стоял бы
# на другой базе, чем проверенный сегодня; дайджест не двигается. Дайджест индекса, а не
# манифеста одной платформы: сборка на Mac (arm64) и в CI (amd64) берёт свою платформу
# из того же индекса. Поднять — тот же тег с новым дайджестом (строка `Digest:` в выводе
# `docker buildx imagetools inspect <образ>`). Сами базы больше не обновляются: исправимую
# уязвимость в них покажет гейт Trivy в CI — тогда и поднимать.

# --- uv --------------------------------------------------------------------
# Той же версии, которой CI сверяет lock-файл и ставит по нему тесты
# (`ci.yml`, шаг setup-uv); совпадение держит `tests/test_python_lock.py`.
# Номер, а не `latest`: иначе образ, собранный завтра, ставил бы другим
# инструментом, чем сегодня. В образ uv не попадает: его подключают
# только на время установки (`RUN --mount`), а 50 МБ инструмента
# сборки в каждом контейнере ни к чему.
FROM ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 AS uv

# --- зависимости питона ----------------------------------------------------
# Базовые образы — официальные образы Docker с зеркала Google (`mirror.gcr.io`), как
# postgres в CI. С Docker Hub ушли 09.10.2026: анонимные скачивания делят лимит по IP
# со всеми машинами GitHub, и «toomanyrequests» уронил сборку образа трижды подряд.
# ECR Public, куда ушли тогда, отказывал «toomanyrequests: Data limit exceeded» 13.10
# и 16.10.2026 — дважды подряд на одном PR: у анонимных скачиваний и там свой лимит,
# а без образа на main выкатывать нечего. Образы те же: зеркало отдаёт официальные
# образы Docker Hub (`library/…`).
FROM mirror.gcr.io/library/python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS python-base

# Окружение — отдельное, в /opt/venv. Не системный питон: `uv sync`
# приводит окружение к lock-файлу точно, то есть удаляет всё, чего
# в нём нет, — в системном снёс бы и собственный pip. Не в /app: его
# ниже отдают пользователю `app`, а chown копирует каждый файл в новый
# слой, и библиотеки уезжали бы в реестр дважды. Питон — только из
# базового образа: скачать свой uv не должен.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_CACHE=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Сначала только зависимости, и только из uv.lock — ровно те версии,
# на которых был зелёным CI. Слой зависит от двух файлов и переживает
# правку кода. `--locked` роняет сборку, если lock-файл отстал от
# pyproject.toml. `--no-dev` — страховка: инструменты разработки лежат
# в extra `dev` и в образ не ставятся и так, но `uv add --dev` положил
# бы новый в группу, которую `uv sync` ставит по умолчанию. Байт-код —
# сразу, как делал pip: иначе каждый процесс компилирует библиотеки
# заново при каждом старте.
COPY pyproject.toml uv.lock ./
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    uv sync --locked --no-dev --no-install-project --compile-bytecode

# --- сервер и воркер -------------------------------------------------------
FROM python-base AS backend

COPY alembic.ini ./
COPY backend ./backend

# Сам проект — поверх готовых зависимостей, обычной установкой, а не
# редактируемой: образ никто не правит, и консольной команде незачем
# зависеть от того, что лежит в /app. Слоем выше проекта нет вовсе
# (`--no-install-project`), и это не мелочь: раньше там стояла пустышка
# `backend/__init__.py`, она перекрывала `/app/backend`, и команда
# внутри контейнера падала на `No module named backend.cli` — проверено
# живым запуском 19.09.2026.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    uv sync --locked --no-dev --no-editable

# Своё имя вместо root: процесс, которому не нужны права, не должен их
# иметь — в том числе внутри контейнера.
RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

# Порт внутри сети докера. Наружу его публикует только компоуз разработки:
# в бою наружу смотрит nginx, а к серверу ходят из своей сети.
EXPOSE 8000

# `--proxy-headers` не украшение: без него счётчик попыток входа видит
# адрес nginx вместо адреса клиента и считает весь интернет одним
# посетителем. Доверять заголовкам можно потому, что снаружи в контейнер
# ходит только nginx из этой же сети.
#
# Журнала запросов у сервера нет (`--no-access-log`, аудит 19.11.2026): он писал
# путь вместе с параметрами — метку отписки из адреса письма и поиск по почте
# и имени. Запросы пишет один журнал — прокси хоста, без параметров и без метки
# (`deploy/proxy/outreach.conf`). `--timeout-graceful-shutdown` — запросы,
# начатые до выкатки, дописываются до 25 с; докер ждёт 30 (`stop_grace_period`
# у api в компоузе), а не умолчание в 10 с, после которого убивает.
CMD ["uvicorn", "backend.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*", \
     "--no-access-log", "--timeout-graceful-shutdown", "25"]

# --- сборка фронта ---------------------------------------------------------
FROM mirror.gcr.io/library/node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS web-build

WORKDIR /web

COPY frontend/package.json frontend/package-lock.json ./
# `npm ci`, а не `npm install`: ставит ровно то, что в замке. Иначе образ,
# собранный завтра, отличается от собранного сегодня, и «у меня работало»
# становится правдой обоих.
RUN npm ci

COPY frontend ./
RUN npm run build

# --- фронт под nginx -------------------------------------------------------
FROM mirror.gcr.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS web

# Пакеты Alpine — до свежих исправлений: гейт образов в CI (Trivy, исправимые CRITICAL) нашёл в
# базе nginx:1.27-alpine (Alpine 3.21.3) brotli-libs 1.1.0 и OpenSSL 3.3.3 при исправленных 1.1.1
# и 3.3.7 (аудит 20.11.2026). Тег nginx не двигаем: обновляются только пакеты системы.
RUN apk upgrade --no-cache

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=web-build /web/dist /usr/share/nginx/html

EXPOSE 80
