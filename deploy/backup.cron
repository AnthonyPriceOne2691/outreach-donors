# Еженедельный бэкап базы с копией вне машины. Ставится человеком на сервере:
#   sudo cp deploy/backup.cron /etc/cron.d/outreach-donors-backup
#   sudo chown root:root /etc/cron.d/outreach-donors-backup
#
# От root: копию снимает `docker compose exec`, а отдельного пользователя
# с правом на докер на машине нет.
#
# Ночь воскресенья: прогонов в это время не бывает, а дамп берёт
# блокировку чтения на минуты.
#
# Куда уезжает копия и куда идут тревоги, здесь не написано намеренно:
# скрипт читает это сам — хранилище из .env.ops, бота из .env рядом
# с компоузом (scripts/ops_env.sh). Так же их читает и ручной запуск перед
# выкаткой, и копия, снятая руками, уезжает туда же, куда ночная.
# Хранилища нет — копия остаётся на машине, и бэкап говорит об этом вслух
# и тревогой; любой отказ — тревога в Telegram.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * 0 root cd /srv/outreach-donors && BACKUP_DIR=/srv/backups/outreach-donors KEEP=3 scripts/backup.sh >> /var/log/outreach-backup.log 2>&1
