# Скопировать в .env и заполнить. Без обязательных переменных приложение
# не стартует и называет, чего не хватает (config/startup_checks.py).

# --- Хранилище ---
STORAGE_DSN=postgresql+asyncpg://outreach:outreach@localhost:5442/outreach
STORAGE_REDIS_URL=redis://localhost:6389/0

# --- Ahrefs ---
AHREFS_API_KEY=
# Лимитов и капа здесь нет: кап — от размера ключа, который называет сам Ahrefs,
# а цикл капа — от обнуления ключа. Ключ может быть общим с соседней системой,
# поэтому остаток спрашивается у Ahrefs, а не считается по своей таблице расхода.
# Сузить кап («не больше N») можно на экране «Расход» — учётке с правом «править пороги».

# --- Выдача ---
SERP_PROVIDER=dataforseo
SERP_LOGIN=
SERP_PASSWORD=
# Песочница провайдера: те же схемы, выдуманные ответы, стоимость ноль.
# Включать для проверки проводки — боевые данные через неё не идут.
SERP_SANDBOX=false
# Режим покупки по умолчанию: live — секунды, $0,002 за страницу; priority — около
# минуты, $0,0012; standard — около пяти минут, $0,0006. Сбор продаж выбирает на запуске.
SERP_MODE=live

# --- Модель ---
LLM_API_KEY=
# Генерация ключей идёт на сильной модели, и это замерено: слабые дают
# общие фразы вместо местных терминов, выдача по ним ловит глобальные
# сайты, и прогон приносит мало местных доноров.
LLM_KEYGEN_MODEL=gpt-5
# Проверка набора — наоборот, дешёвой: её работа отбросить выдуманное.
LLM_JUDGE_MODEL=gpt-5-mini
# Модель уникализации письма. Та же причина, что у генерации ключей:
# слабая примешивает чужой язык и сваливается в шаблон (okf/letter-zones.md).
LLM_LETTERS_MODEL=gpt-5
# Модель агента переписки (черновики ответов собеседнику).
LLM_AGENT_MODEL=gpt-5
# Модель вида ответа лида продаж: от вида зависит, позвонят ли человеку
# и закроют ли его адрес. Та же, что у разбора цены, до замера на наборе.
LLM_SALES_CLASSIFY_MODEL=gpt-5
# Модели агента продаж, по одной на вызов. Черновик ответа лиду — сильная
# модель: письмо живому человеку. Ситуация письма и судья черновика — дешёвая:
# метка и строгая форма. Выбор не замерен — его меряет прогон на накопленных
# ответах; ключ — общий LLM_API_KEY.
LLM_SALES_DRAFT_MODEL=gpt-5
LLM_SALES_SITUATION_MODEL=gpt-5-mini
LLM_SALES_JUDGE_MODEL=gpt-5-mini
# Судья сегмента сбора базы продаж: подходит ли сайт под сегмент гипотезы — дешёвая
# модель, как у судьи площадки: прочесть текст сайта и процитировать. Не замерено —
# меряет eval на наборе (scripts/eval_sales_segment.py).
LLM_SALES_SEGMENT_MODEL=gpt-5-mini
# Тематика сайта (тема из общего списка, docs/SITE_TOPICS.md): дешёвая модель, как у судьи
# площадки. Точность меряет eval на наборе (scripts/eval_topic.py).
LLM_TOPIC_MODEL=gpt-5-mini
LLM_MODEL=
# Потолки расхода на модель, в токенах по журналу расхода (0 — нет потолка).
# День — по всем операциям модели (судья, ключи, письма, разбор ответов);
# прогон — по строкам с номером прогона. При превышении: прогон останавливается
# с причиной, сборка писем — с отчётом, разбор ответа откладывается, пул ключей
# не собирается. Токены видны на экране «Расход».
LLM_DAILY_TOKEN_CAP=0
# Свои дневные потолки частей — внутри общего, проверяются оба: черновики агента
# и вызовы модели продаж вне агента (вид ответа лида, сборка писем очереди).
# Пусто — доля общего (30 % и 20 %), 0 — своего потолка нет. Опечатка в потолке продаж
# процессы не роняет: продажам — ноль токенов и строка журнала при старте.
AGENT_DAILY_TOKEN_CAP=
SALES_DAILY_TOKEN_CAP=
LLM_RUN_TOKEN_CAP=0

# --- Судья площадки (okf/selection-audit.md) ---
# off — не зовётся; shadow — судит и считает, но не режет; enforce — режет.
# shadow — то же, что умолчание в коде: вердикт судьи сортирует очередь
# рассмотрения. Боевой прогон 23.09 прошёл вовсе без судьи из-за off здесь.
JUDGE_MODE=shadow
# low, а не minimal: на minimal модель не вспоминает, чей домен.
JUDGE_REASONING_EFFORT=low
# Главная — вторая сторона: магазин с журналом в выдаче выглядит изданием.
JUDGE_HOME_CHECK=true

# --- Тематика сайта (docs/SITE_TOPICS.md) ---
# on — прогон определяет тему новым сайтам рядом с судьёй, тем же текстом (выдача и
# главная, которую судья уже открыл); off — модель не зовётся. Токены — в журнал расхода
# (операция site_topic) и в дневной потолок модели. Уже записанным — `outreach topic-backfill`.
TOPIC_MODE=on
TOPIC_REASONING_EFFORT=low
# Срок темы — год; «не ясна» (модель прочла и темы не назвала) — месяц: текст бывает богаче.
TOPIC_TTL_DAYS=365
TOPIC_UNCLEAR_TTL_DAYS=30
# Цена токена модели тематики, $ за миллион входа и вывода: по ней досуд называет деньги
# до траты. Публичный прайс OpenAI для GPT-5 mini; сменили модель — смените и цены.
TOPIC_INPUT_USD_PER_1M_TOKENS=0.25
TOPIC_OUTPUT_USD_PER_1M_TOKENS=2.0

# --- Докер ---
# Нужны компоузу всего стека (docker compose up). Пустые значения здесь
# намеренно: файл едет в git, а гейт `secret-in-example` роняет пуш,
# если в образце заполнено значение переменной с именем на PASSWORD,
# SECRET, TOKEN и подобное.
# Только латиница и цифры: пароль вставляется в адрес базы, и символы
# @ / : его ломают. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=
WEB_PORT=8090
# Образы из реестра. На сервере задать ОБЯЗАТЕЛЬНО: без них компоуз
# соберёт образ на месте, а сборка фронта берёт 2–3 ГБ памяти рядом
# с соседней системой. Для разработки оставить пустыми — соберётся локально.
# BACKEND_IMAGE=ghcr.io/anthonypriceone2691/outreach-donors-backend:main
# WEB_IMAGE=ghcr.io/anthonypriceone2691/outreach-donors-web:main

# --- Журнал ---
# Формат не задаётся здесь намеренно: в докере он json (для сборщика
# логов), при запуске руками — text. Задать LOG_FORMAT, чтобы переопределить.
LOG_LEVEL=INFO

# --- Доступ ---
# Секрет подписи пропусков. Умолчания нет намеренно: строка вроде
# «change-me» однажды уезжает в прод, и любой выписывает себе пропуск
# администратора. Сгенерировать: openssl rand -hex 32
ACCESS_JWT_SECRET=
ACCESS_TOKEN_TTL_HOURS=24
# Неудачных попыток входа в минуту — на почту и на адрес обращения.
# Десяти хватает человеку, ошибшемуся раскладкой, и не хватает перебору.
ACCESS_LOGIN_ATTEMPTS_PER_MINUTE=10

# --- Поиск контактов ---
# Ступень RDAP выключена: на замерах ноль адресов из 58 доменов при каждом
# пятом запросе в таймаут. Включается здесь, счётчик в отчёте остаётся.
CONTACTS_RDAP_ENABLED=false
# Обход страниц: сколько страниц разбираем и сколько запросов на это тратим.
# Числа разные намеренно: сайт отвечает 404 на большинство угадываемых
# адресов, и общий счётчик заканчивался бы на несуществующих страницах.
# Ступень браузера: включать на отдельном проходе (outreach contacts --browser).
# Требует: uv sync --extra browser && playwright install chromium
CONTACTS_BROWSER_ENABLED=false
CONTACTS_MAX_PAGES=8
CONTACTS_MAX_ATTEMPTS=24
# «Искать глубже» — один донор по кнопке: шире обход, карта сайта, браузер (если он есть
# в окружении: в образе прода его нет), без платной ступени, потолок времени на домен.
CONTACTS_DEEP_MAX_PAGES=20
CONTACTS_DEEP_MAX_ATTEMPTS=60
CONTACTS_DEEP_BROWSER_PAGES=6
CONTACTS_DEEP_TIMEOUT_SEC=240
# Платный сервис поиска адресов. Зовётся только на остаток доменов,
# которые не нашлись своим парсингом и RDAP (okf/contact-ladder.md).
CONTACTS_HUNTER_API_KEY=
# Платный поиск адресов доноров и рекламодателей включается этим флагом, а не
# ключом выше (решение 12.10.2026): ключ и учётка Hunter общие с проверкой адресов
# продаж (SALES_VERIFIER_PROVIDER=live); поиски у Hunter считаются отдельно от
# проверок, квоту поисков делят доноры, рекламодатели и сбор базы продаж. false —
# ступень 3 у доноров и рекламодателей не зовётся нигде: ни автопоиском после
# «принять», ни кнопкой, ни консолью; бесплатные ступени работают. Сбор базы
# продаж платит по своему флагу SALES_SEGMENT_PAID_CONTACTS.
CONTACTS_PAID_SEARCH_ENABLED=false
# Прогон по файлу (contacts-file) проверяет сеть по заведомо живым адресам,
# чтобы без сети не тратить попытки доменов. За фильтром, который закрывает
# адреса по умолчанию (google, cloudflare, github), — свои через запятую;
# пустое значение выключает проверку.
# CONTACTS_NETWORK_PROBES=https://www.google.com/generate_204,https://github.com/

# --- Обход Этапа 2: платные уровни и свой потолок ---
# Всё пусто — платных уровней нет и обход идёт как до них (docs/CRAWL.md). Платный
# уровень зовётся, только когда заданы и он, и его цена, и свой потолок Этапа 2.
# Резидентные прокси — списком через запятую или с новой строки: при отказе через
# прокси и при просевшем здоровье обхода — смена на следующий. Прежнее имя
# CRAWL_PROXY_URL (один адрес) тоже читается. Адрес — http(s):// или socks5://,
# «#», «?», «/» и «@» в логине и пароле — закодированными (%23, %3F, %2F, %40):
# битый адрес — отказ обходчика на старте.
CRAWL_PROXY_URLS=
# Цена трафика прокси, $ за гигабайт. Пусто — прокси не зовётся.
CRAWL_PROXY_USD_PER_GB=
# Сервис рендеринга — только для страниц, вернувшихся пустыми. Адрес API — https
# с хостом и подстановками {url} и {key}; без {key} ключ уходит заголовком
# Authorization: Bearer. Ключа нет — сервиса нет (okf/crawl-access.md).
# CRAWL_RENDER_API_URL=https://render.example/v1/?api_key={key}&render_js=true&url={url}
CRAWL_RENDER_API_KEY=
# Цена вызова сервиса, $ за 1 000. Пусто — сервис не зовётся.
CRAWL_RENDER_USD_PER_1K=
# Свой потолок Этапа 2 на прокси и рендеринг, $ за календарный месяц. Пусто —
# прокси и рендеринг не зовутся вовсе (как ставить — okf/stage2-economy.md).
CRAWL_MONTH_CAP_USD=

# --- Рассылка ---
# Всё ниже подключается на боевой машине, когда готовы почтовые домены.
# До того сервис работает целиком, а экран писем говорит, чего не хватает.
# Секрет подписи метки в адресе «куда отвечать» и секрет вебхука приёма.
# Без него ответ с чужого адреса не привязывается ни к чему и выглядит
# как «донор не ответил».
#
# Только латиница и цифры: секрет едет в заголовке HTTP, а заголовки
# бывают только ASCII. Сгенерировать: openssl rand -hex 32
#
# В кабинете SendGrid (Inbound Parse) адрес вебхука задаётся с секретом
# паролем: https://inbound:СЕКРЕТ@домен/api/inbound/replies — своих
# заголовков платформа не шлёт, а пароль из адреса едет заголовком.
OUTREACH_INBOUND_SECRET=
# Приставка поддомена ответов. Адрес «куда отвечать» стоит на домене
# отправителя: письмо с anna@mail-a.example просит отвечать на
# anna+метка@replies.mail-a.example (docs/OUTREACH_THREADS.md). Один общий
# домен для ответов связал бы все домены рассылки между собой: упала его
# репутация — упали все. Поэтому здесь приставка, а не домен, и MX
# replies.<домен> → mx.sendgrid.net заводится у каждого домена отправки
# (deploy/README.md). Пустое значение отправка не примет — без строки
# вовсе работает умолчание replies.
OUTREACH_REPLY_SUBDOMAIN=replies

# Чем письмо уходит наружу. `null` ничего не шлёт и работает только
# на выдуманных доменах (.example.test) — так и должно быть, пока
# не заведены двадцать почтовых доменов.
#
# `sendgrid` шлёт по-настоящему. Переключать его можно только после того,
# как у доменов настроены SPF, DKIM и DMARC, а у платформы — Domain
# Authentication: письмо с неподписанного домена уходит прямо в спам
# и жжёт репутацию, ради которой всё и затевалось.
OUTREACH_TRANSPORT=null
OUTREACH_SENDGRID_API_KEY=

# Предохранитель первых дней: пока список не пуст, боевой транспорт
# пишет только на эти адреса или домены (через запятую). Первые письма
# уходят на свои ящики — проверить формат, заголовки цепочки и отписку.
# Пустой список означает «кому угодно», и каждое письмо говорит об этом
# отдельной строкой в логе.
OUTREACH_ALLOWED_RECIPIENTS=

# Открытый ключ, которым платформа подписывает события доставки (base64
# из её кабинета, там же включается подписывание). Пусто — вебхук
# отказывает всем: событие о недоставке двигает статус письма, а серия
# таких снимает домен с отправки, и делать это по чужой просьбе нельзя.
OUTREACH_EVENTS_PUBLIC_KEY=

# Своя учётка платформы у направления (этапа) — приставка OUTREACH_<ЭТАП>_:
# у направления бывает свой субаккаунт и свои домены, и его письма уходят
# его ключом. Чего своего нет — берётся общее (строки выше), кроме списка
# разрешённых при своём ключе (с 05.10.2026): своя учётка — свой список. Строки
# OUTREACH_<ЭТАП>_ALLOWED_RECIPIENTS нет — отказ, почта этапа не собирается и его
# письма не уходят; пустая строка `=` — без предохранителя.
# События всех учёток принимает один вебхук: подпись сверяется с каждым
# ключом. Пример для этапа sales:
# OUTREACH_SALES_SENDGRID_API_KEY=
# OUTREACH_SALES_EVENTS_PUBLIC_KEY=
# OUTREACH_SALES_ALLOWED_RECIPIENTS=

# Имя в подписи письма. Пока не задано, отправка отказывает: в подписи
# стоит громкая метка, а не имя.
OUTREACH_SENDER_NAME=
# Автопилот агента переписки: 1 — агент сам отправляет ответ в границах
# настроек этапа, если этапу автопилот разрешён в коде и включён на экране;
# 0 — только черновики, отправляет человек. На проде 0.
OUTREACH_AGENT_AUTOPILOT=0
# Почтовый адрес отправителя — строка подписи под именем (решение 11.10.2026;
# юридического блока в письме нет с 23.09.2026). Пока не задан, отправка
# писем доноров и рекламодателей отказывает: в подписи стоит громкая метка.
OUTREACH_POSTAL_ADDRESS=
# Адрес страницы отписки БЕЗ метки: к нему дописывается подписанная метка
# донора, и получается ссылка для заголовка List-Unsubscribe (в тексте
# письма ссылки нет). Страницу отдаёт сам сервер, то есть это наш публичный
# адрес плюс `/api/unsubscribe`, например
# https://parsing-prices.example/api/unsubscribe
#
# Подписывается метка секретом приёма почты: пуст OUTREACH_INBOUND_SECRET или
# этот адрес — ссылки нет, и письмо доноров и рекламодателей не уходит: отправка
# отказывает словами, экран писем называет недостающее (сверка ТЗ 12.10.2026).
OUTREACH_UNSUBSCRIBE_URL=
# Передача лида (ответ рекламодателя, взятый в работу) в CRM: POST с JSON
# {"event": "lead_taken", "event_id", "lead": {…}} и подписью в заголовке
# X-Outreach-Signature: t=<время>,v1=<hex HMAC-SHA256 от «время.тело»> секретом ниже.
# Пусто — вебхук не уходит; лиды всегда можно выгрузить CSV с экрана «Диалоги».
# Только https. Повтор события (тот же event_id) — получатель отвечает 2xx или
# 409; 4xx — отказ без повтора, 5xx/408/429/обрыв — повтор очередью. По
# перенаправлениям 3xx не идём — указывать конечный адрес.
OUTREACH_LEAD_WEBHOOK_URL=
OUTREACH_LEAD_WEBHOOK_SECRET=

# Сроки добивок по умолчанию — в днях от ПРЕДЫДУЩЕГО письма, через запятую.
# «7,7»: первая добивка через 7 дней после первого письма, вторая — ещё через 7,
# то есть на 7-й и 14-й день, как в ТЗ. «7,14» здесь значило бы 7-й и 21-й день.
# Это умолчание новой рассылки: свои сроки рассылка получает на экране сборки
# и хранит у себя.
OUTREACH_FOLLOWUP_DAYS=7,7

# Уверенность разбора цены, ниже которой ответ уходит человеку, а не
# в базу. Приёмка требует не более 5% ошибок извлечения,
# и без этой ветки порог не держится (okf/reply-parsing.md).
OUTREACH_PRICE_CONFIDENCE=0.80

# --- Продажи ---
# Модуль продаж в этом развёртывании. Выключен по умолчанию: продажи пишут
# живым людям от имени компании, и включает их человек. Сейчас в модуле только
# данные — гипотезы и лиды; гипотезы заводятся командой
# outreach sales-hypothesis-add. Выключатель читают срезы, приносящие работу
# продаж; первой — проверка ключей продаж на старте.
SALES_ENABLED=false
# Агент переписки на этапе продаж: черновики ответов лидам моделью, судья
# черновика и сообщение о черновике в группу продаж ботом продаж. Выключен по
# умолчанию — включает владелец, когда агент замерен на наборе ответов.
SALES_AGENT_ENABLED=false
# Сколько ответов лида в одном диалоге агент продаж ведёт черновиком: ход —
# ответ лида по порядку в диалоге; со следующего черновика нет — отвечает
# человек, причина словами в карточке ответа. От 1 до 10; иное — черновика
# нет, причина словами у ответа (сервис при этом поднимается).
SALES_AGENT_MAX_TURNS=2
# Проверяльщик адресов лидов перед первым письмом: fixture — вердикты по
# правилам из самого адреса, без сети и денег; live — Hunter Email Verifier
# ключом CONTACTS_HUNTER_API_KEY (он общий с соседней системой; счётчик
# проверок у Hunter свой, отдельный от поисков). На live переключает человек;
# live без ключа — отказ на старте.
SALES_VERIFIER_PROVIDER=fixture
# Месячный потолок платных проверок адреса у live — единицы sales_verify журнала
# расхода с первого числа, в пределах месячных проверок тарифа Hunter.
# У live обязателен: пусто или не число — платная часть очистки встаёт словами,
# лиды ждут следующей очистки, бесплатные правила идут. Число — решение владельца
# по тарифу Hunter.
SALES_VERIFIER_MONTH_CAP=
# Hunter ответил «ещё проверяет» (HTTP 202) и после двух переспросов прохода: перепроверка
# адреса идёт сама — через SALES_VERIFY_AGAIN_MIN минут (1–1440); окно — SALES_VERIFY_AGAIN_TRIES
# таких перепроверок (1–20) от первого «ещё проверяет», дальше лид отклонён словами «адрес не
# проверить». Временный отказ сервиса посреди окна срок не снимает. Переспрос, пока Hunter
# проверяет, бесплатен; вердикт — проверка в счёт месячного потолка.
SALES_VERIFY_AGAIN_MIN=20
SALES_VERIFY_AGAIN_TRIES=3
# Kommo — CRM, куда уходит лид: сделка, контакт и компания одним запросом.
# fixture — без сети, сделки с выдуманными номерами; live — закрытая
# интеграция аккаунта. На live переключает человек: записанное в CRM не
# отзывается. live без любого из пяти значений ниже — отказ на старте.
# live с адресом шлюза агентства (SALES_KOMMO_GATEWAY_URL ниже) — через шлюз.
SALES_KOMMO_PROVIDER=fixture
# Поддомен аккаунта: acme из acme.kommo.com.
SALES_KOMMO_SUBDOMAIN=
# Долгоживущий ключ закрытой интеграции. Секрет: только в .env.
SALES_KOMMO_TOKEN=
# Номера воронки, её этапа и ответственного за новые сделки — из настроек Kommo.
SALES_KOMMO_PIPELINE_ID=
SALES_KOMMO_STATUS_ID=
SALES_KOMMO_RESPONSIBLE_USER_ID=
# Шлюз агентства вместо API v4: при live и заданном адресе сделка с контактом
# и первым примечанием уходит одним POST на этот адрес (https://…), ключ — в
# заголовке. Тогда нужны ещё ключ, источник и тег, а из значений выше — воронка,
# этап и поддомен (ссылка на сделку телемаркетологу); ключ закрытой интеграции и
# ответственный шлюзу не нужны. Без любого из них — отказ на старте. Примечаний
# к уже заведённой сделке шлюз не принимает: следующий ответ лида уходит
# телемаркетологу сообщением со ссылкой на ту же сделку. Адрес пуст — напрямую.
SALES_KOMMO_GATEWAY_URL=
# Ключ шлюза. Секрет: только в .env.
SALES_KOMMO_GATEWAY_KEY=
# Значение поля источника сделки и тег сделки и контакта — только для шлюза.
SALES_KOMMO_SOURCE=
SALES_KOMMO_TAG=
# Обязательные поля сделки в Kommo — постоянными значениями: JSON «номер поля →
# значение» (текст, число или true/false), например {"712345": "Email"}. Форму
# проверяет сборка клиента live: негодная — передача лида кончается отказом
# словами и тревогой. Только для API v4 напрямую: шлюз агентства полей сделки
# не принимает — с ним настройка — тот же отказ словами. Пусто — полей нет.
SALES_KOMMO_LEAD_FIELDS=
# Уверенность вида ответа лида, ниже которой ответ ждёт человека, а не идёт
# своим путём (созвон, агент, закрыть). Порог утверждает владелец по замеру
# на наборе ответов (scripts/eval_sales_reply.py).
SALES_REPLY_CONFIDENCE=0.80
# Каталог внешнего набора ответов лидов для eval вида ответа
# (scripts/eval_sales_reply.py --golden): обезличенная переписка — вне
# репозитория, в репозитории только манифест набора.
SALES_GOLDEN_DIR=
# Автоответ в треде продаж («в отпуске до …») цепочку не останавливает:
# следующий шаг ждёт даты возвращения, если она есть в тексте, иначе —
# столько дней от автоответа.
SALES_OOO_DELAY_DAYS=7
# Вызовов модели на первое письмо в одной сборке очереди продаж. После каждого
# сборка подбирает, какие переписанные зоны принять, чтобы письмо легло в коридор
# отличия; ни один набор не лёг — модель переписывает заново с подсказкой, куда и
# на сколько промахнулась прошлая попытка. 1 — без повтора (лид ждёт следующей
# сборки), до 10.
SALES_REWRITE_ATTEMPTS=3
# Автоотправка первых писем продаж по расписанию, без человека: проход процесса разбора
# (reaper) раз в SALES_AUTOSEND_PASS_SEC секунд берёт письма очереди, у чьих получателей
# сейчас рабочие часы, старшие первыми, и отдаёт их общей отправкой — с теми же стоп-листами,
# предохранителем, капом, разгоном и лимитами домена, что у кнопки. С ящика — не больше письма
# за проход и пауза SALES_AUTOSEND_GAP_MIN минут ±50% между его первыми письмами. Пока письмо
# продаж в блоке «Исход неизвестен» (отправляется дольше 5 минут), проход стоит. Почта не
# ответила на письмо прохода — этот проход обрывается сразу, письмо остаётся «отправляется»,
# а следующие проходы шлют дальше, пока ему нет 5 минут. Платформа отказывает любому письму
# (ключ, учётка, частота, недоступна) — проход стоит сразу; отказ одному письму (стоп-лист,
# адресат, содержимое) проход не останавливает и тревоги не даёт, даже если так отказано
# каждому письму окна. Стоит так или падает дольше 15 минут подряд при письмах в окне
# получателя и свободном капе — тревога в Telegram (ALERT_TELEGRAM_*).
# Работает только при SALES_ENABLED и пустом OUTREACH_SALES_ALLOWED_RECIPIENTS: пока список
# своих адресов не пуст, первые письма продаж уходят кнопкой, а автоотправка не включается.
# Выключена по умолчанию: первые письма незнакомым людям без человека включает владелец.
SALES_AUTOSEND=false
SALES_AUTOSEND_PASS_SEC=60
SALES_AUTOSEND_GAP_MIN=15
# Автосборка очереди продаж: писем в очереди меньше, чем ящики продаж отправят за сутки (сумма
# дневных капов с разгоном), — проход раз в 10 минут ставит ту же сборку, что кнопка «Собрать
# очередь», с пределом недостачи (не больше 200): одну за раз, гипотезы по очереди; модель
# переписывает письма без человека, под тем же потолком. Выключена по умолчанию.
SALES_AUTOBUILD=false
# Передача лида телемаркетологу: свой бот продаж (не бот тревог — его недоставка
# сама поднимает тревогу владельцу через ALERT_TELEGRAM_*). Токен — от @BotFather,
# секрет: только в .env. Телемаркетолог жмёт Start у бота, бота добавляют в группу
# продаж; номера чатов печатает outreach sales-telegram-chat-id.
SALES_TELEGRAM_BOT_TOKEN=
SALES_TELEGRAM_CHAT_ID=
SALES_TELEGRAM_GROUP_CHAT_ID=
# Копия сообщения о лиде в группу продаж; false — только личное сообщение.
SALES_TELEGRAM_GROUP_COPY=true
# Адрес сервиса для ссылки на диалог (https://…, без косой черты в конце): она
# уходит вместо ссылки на сделку, пока Kommo не подключён или не ответил.
SALES_APP_URL=
# Недельный отчёт продаж за прошлую неделю (пн–вс по Москве) — в группу продаж
# ботом продаж, один раз за неделю: день и время по Москве (MON … SUN, ЧЧ:ММ),
# рекомендуемое — MON 09:00. Пусто (по умолчанию) — в Telegram не уходит: всё, что
# продажи шлют наружу без человека, включает человек. Экран «Продажи → Отчёт» и CSV
# работают и без него.
SALES_WEEKLY_REPORT_AT=
# Судья черновика продаж: enforce — нарушения возвращают черновик на правку,
# не сошлось — человеку; shadow — вердикт пишется в журнал и в попытки
# черновика, но черновик не задерживает (замер судьи на живых черновиках).
# Не смог проверить — человеку в обоих режимах.
SALES_JUDGE_MODE=enforce
# Наборы eval судьи продаж — вне репозитория (scripts/eval_sales_judge.py
# --golden и --style): опора на базу знаний и стиль. Пусто — eval по набору
# отказывает словами «набор не найден».
SALES_JUDGE_GOLDEN_DIR=
SALES_STYLE_GOLDEN_DIR=
# Ворота автоответа агента продаж: сколько решений по ситуации нужно, прежде чем
# экран «Агент: качество» судит её доли — без правки (порог 80%) и верное молчание
# (90%). Меньше — «данных мало», без долей и вывода. 30: ноль ложных молчаний на 30 —
# с уверенностью 95% их не больше 10% (правило трёх); доля 80% на 30 решениях —
# плюс-минус 7 пунктов. От 5 до 1000. Автоответ этим не включается: флаг ситуации
# включает человек.
SALES_AUTOREPLY_MIN_N=30
# Судья сегмента сбора базы (ключи → выдача → судья → адрес → лиды): shadow — вердикт
# пишется, а «отказ» модели не отсекает сайт, а отдаёт его человеку; enforce — режет;
# off — модель не зовётся, каждый сайт решает человек. enforce — по замеру на наборе.
SALES_SEGMENT_JUDGE_MODE=shadow
# Набор eval судьи сегмента — вне репозитория (scripts/eval_sales_segment.py --golden).
SALES_SEGMENT_GOLDEN_DIR=
# Цена токена модели судьи сегмента (LLM_SALES_SEGMENT_MODEL), $ за миллион входа и вывода: по ней
# смета и отчёт прогона называют деньги рядом с токенами. Публичный прайс OpenAI для GPT-5 mini
# (openai.com/api/pricing); сменили модель — смените и цены.
SALES_SEGMENT_INPUT_USD_PER_1M_TOKENS=0.25
SALES_SEGMENT_OUTPUT_USD_PER_1M_TOKENS=2.0
# Платный поиск адреса (Hunter) у сбора: false — только бесплатные ступени лестницы. Ключ Hunter
# общий с донорами: без этого флага его включение для доноров не включает платное сбору.
SALES_SEGMENT_PAID_CONTACTS=false
# Сколько сайтов судья сегмента судит разом (главная сайта и вызов модели): скользящее окно —
# освободилось место, берётся следующий сайт. Своя настройка: общий JUDGE_CONCURRENCY — у судьи
# доноров. От 1 до 64.
SALES_SEGMENT_JUDGE_CONCURRENCY=16
# Сайт не ответил поиску адреса сбора — повтор по сроку (следующий проход, день, неделя) идёт
# сам, без кнопки, но не раньше стольких минут после попытки. От 1 до 1440.
SALES_SEGMENT_AGAIN_MIN=30
# Сколько знаков видимого текста главной видит судья сегмента сверх выдачи и шапки главной: по ним
# понятнее вид сайта и его язык. Текст — из общего разбора главной. 0 — без текста главной. От 0
# до 8000.
SALES_SEGMENT_HOME_TEXT_CHARS=1500

# --- Тревоги в Telegram ---
# Одна строка в чат, когда что-то кончилось плохо: прогон остановлен насовсем,
# бэкап не снят или не уехал с машины, контейнер нездоров или упал. Журнал
# и экран читают, когда уже что-то ищут, — тревога приходит сама.
#
# Читают и контейнеры (остановленный прогон), и кроны хоста (бэкап, сторож
# контейнеров) — из этого же файла, поэтому на сервере строки живут в `.env`.
# Пусто — сервис работает, а каждая несостоявшаяся тревога пишет в журнал
# громкую строку «ТРЕВОГА НЕ ОТПРАВЛЕНА».
#
# Токен выдаёт @BotFather (/newbot), номер чата — getUpdates после первого
# сообщения боту; шаги — deploy/README.md, «Копия вне машины и тревоги».
# Проверить: scripts/alert.sh "проверка" (с хоста) и
# docker compose exec api python -m backend.shared.alerts "проверка" (из контейнера).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Адрес Bot API меняется только для проверки подставным сервером.
# ALERT_TELEGRAM_API=https://api.telegram.org

# --- Копия бэкапа вне машины ---
# S3-совместимое хранилище: Cloudflare R2 или Backblaze B2. Их читают только
# кроны хоста (scripts/backup.sh → scripts/offsite.sh), и на сервере эти строки
# кладутся НЕ в `.env`, а в `.env.ops` рядом с ним (chmod 600): компоуз отдаёт
# `.env` в контейнеры целиком, и ключ, которым можно стереть копии, оказался бы
# в сервере, смотрящем в интернет. Скрипты читают оба файла сами.
#
# Пусто — копия остаётся на той же машине, и бэкап говорит об этом вслух
# и тревогой. Старые копии удаляет правило жизненного цикла бакета (90 дней),
# а не скрипт — ключу не нужно право удалять.
#
# Адрес — из кабинета целиком: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# или https://s3.<регион>.backblazeb2.com; поставщик и регион скрипт берёт
# из него (BACKUP_S3_PROVIDER и BACKUP_S3_REGION — только если догадка не та).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET=
# Папка в бакете: бакет может быть общим у сервисов машины.
BACKUP_S3_PREFIX=outreach-donors
